{
  "name": "commute-help",
  "version": "1.0.0",
  "description": "Local-first road closure and commute planning for Portland-Vancouver",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/print-startup.mjs && concurrently --kill-others --names api,web --prefix-colors cyan,magenta \".venv/bin/python -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8787 --reload\" \"npm --prefix frontend run dev -- --host 0.0.0.0 --port 5173 --strictPort\"",
    "graph:build": ".venv/bin/python -m scripts.build_graph",
    "graph:validate": ".venv/bin/python -m scripts.validate_graph",
    "sumo:freeze-osm": ".venv/bin/python -m scripts.freeze_osm_source",
    "sumo:build-network": ".venv/bin/python -m scripts.build_sumo_network",
    "sumo:build-edge-map": ".venv/bin/python -m scripts.build_sumo_edge_map",
    "sumo:audit-migration": ".venv/bin/python -m scripts.validate_graph_migration",
    "sumo:validate-network": ".venv/bin/python -m scripts.validate_sumo_network",
    "sumo:promote-phase1": ".venv/bin/python -m scripts.promote_sumo_phase1",
    "backup": ".venv/bin/python -m scripts.backup",
    "backup:verify": ".venv/bin/python -m scripts.backup --verify",
    "doctor": ".venv/bin/python -m scripts.doctor",
    "sumo:doctor": ".venv/bin/python -m scripts.sumo_doctor",
    "traffic:campaign": "node scripts/portal-campaign.mjs",
    "traffic:finalize": ".venv/bin/python -m scripts.finalize_portal_campaign",
    "traffic:match-stations": ".venv/bin/python -m scripts.match_portal_stations",
    "traffic:build-profiles": ".venv/bin/python -m scripts.build_portal_profiles",
    "traffic:build-edge-priors": ".venv/bin/python -m scripts.build_edge_priors",
    "traffic:build-background-seed": ".venv/bin/python -m scripts.build_background_seed",
    "traffic:intake-regional-od": ".venv/bin/python -m scripts.intake_regional_od",
    "test": "npm run test:campaign && npm run test:backend && npm run test:frontend",
    "test:campaign": "node --test scripts/portal-campaign.test.mjs",
    "test:backend": ".venv/bin/python -m pytest backend/tests",
    "test:frontend": "npm --prefix frontend run lint && npm --prefix frontend run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
