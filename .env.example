# Copy this file to .env only when you need to override local defaults.
COMMUTE_HELP_ENVIRONMENT=development
COMMUTE_HELP_DATABASE_PATH=data/app.db
COMMUTE_HELP_GRAPH_PATH=data/graphs/portland-vancouver.graphml
COMMUTE_HELP_GRAPH_MANIFEST_PATH=data/graphs/graph-manifest.json
COMMUTE_HELP_TRAFFIC_PATH=data/traffic
COMMUTE_HELP_TRAFFIC_SCHEDULE_PATH=data/traffic/processed/schedules/active/schedule.parquet
COMMUTE_HELP_TRAFFIC_SCHEDULE_MANIFEST_PATH=data/traffic/processed/schedules/active/schedule-manifest.json
COMMUTE_HELP_PROXY_OD_SEED_PATH=data/traffic/processed/background-seeds/2026-08-08-portland-vancouver-frozen-v2/od-demand-seeds.parquet
COMMUTE_HELP_PROXY_OD_REPORT_PATH=data/traffic/processed/background-seeds/2026-08-08-portland-vancouver-frozen-v2/validation-report.json
COMMUTE_HELP_SUMO_RUNTIME_MODE=auto
COMMUTE_HELP_SUMO_OFFLINE_ONLY=true
COMMUTE_HELP_SUMO_MAX_PARALLEL_RUNS=1
COMMUTE_HELP_SUMO_MAX_RUN_SECONDS=28800
COMMUTE_HELP_SUMO_MAX_RUN_DISK_MB=2048
COMMUTE_HELP_SUMO_COMPUTE_CHUNK_SECONDS=100
