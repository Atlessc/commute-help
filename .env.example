# Copy this file to .env only when you need to override local defaults.
COMMUTE_HELP_ENVIRONMENT=development
COMMUTE_HELP_DATABASE_PATH=data/app.db
COMMUTE_HELP_GRAPH_PATH=data/graphs/portland-vancouver.graphml
COMMUTE_HELP_GRAPH_MANIFEST_PATH=data/graphs/graph-manifest.json
COMMUTE_HELP_TRAFFIC_PATH=data/traffic
COMMUTE_HELP_SUMO_RUNTIME_MODE=auto
COMMUTE_HELP_SUMO_OFFLINE_ONLY=true
COMMUTE_HELP_SUMO_MAX_PARALLEL_RUNS=1
COMMUTE_HELP_SUMO_MAX_RUN_SECONDS=3600
COMMUTE_HELP_SUMO_MAX_RUN_DISK_MB=2048
